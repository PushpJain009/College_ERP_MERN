# =============================================================================
# COLLEGE ERP - ENVIRONMENT CONFIGURATION (EXAMPLE)
# =============================================================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control
# =============================================================================

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================
NODE_ENV=development
PORT=5000
API_VERSION=v1

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# MongoDB Connection String
# Local: mongodb://localhost:27017/college_erp
# Atlas: mongodb+srv://<username>:<password>@cluster.mongodb.net/college_erp
MONGO_URI=mongodb://localhost:27017/college_erp

# =============================================================================
# AUTHENTICATION & SECURITY
# =============================================================================
# JWT Secret Key (Use a strong random string in production)
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production

# JWT Expiration (e.g., 1h, 7d, 30d)
JWT_EXPIRE=30d

# Bcrypt Salt Rounds (10-12 recommended)
BCRYPT_SALT_ROUNDS=12

# =============================================================================
# CORS CONFIGURATION
# =============================================================================
# Frontend URL (for CORS)
CLIENT_URL=http://localhost:3000

# Allowed Origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# =============================================================================
# EMAIL CONFIGURATION
# =============================================================================
# Email Service Provider (gmail, sendgrid, ses, etc.)
EMAIL_SERVICE=gmail

# SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_specific_password

# SendGrid (Alternative)
SENDGRID_API_KEY=your_sendgrid_api_key
SENDGRID_FROM_EMAIL=noreply@collegeerp.com
SENDGRID_FROM_NAME=College ERP

# AWS SES (Alternative)
AWS_SES_REGION=us-east-1
AWS_SES_ACCESS_KEY_ID=your_aws_access_key
AWS_SES_SECRET_ACCESS_KEY=your_aws_secret_key

# =============================================================================
# SMS CONFIGURATION (Optional)
# =============================================================================
# Twilio
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# AWS SNS (Alternative)
AWS_SNS_REGION=us-east-1
AWS_SNS_ACCESS_KEY_ID=your_aws_access_key
AWS_SNS_SECRET_ACCESS_KEY=your_aws_secret_key

# =============================================================================
# FILE UPLOAD & STORAGE
# =============================================================================
# Upload Directory (local storage)
UPLOAD_DIR=./uploads

# Maximum File Size (in bytes) - 10MB default
MAX_FILE_SIZE=10485760

# Allowed File Types (comma-separated)
ALLOWED_FILE_TYPES=.pdf,.doc,.docx,.jpg,.jpeg,.png,.gif

# AWS S3 Configuration (for cloud storage)
AWS_S3_BUCKET_NAME=your_s3_bucket_name
AWS_S3_REGION=us-east-1
AWS_S3_ACCESS_KEY_ID=your_aws_access_key
AWS_S3_SECRET_ACCESS_KEY=your_aws_secret_key

# Cloudinary (Alternative)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# =============================================================================
# PAYMENT GATEWAY (Optional)
# =============================================================================
# Stripe
STRIPE_PUBLIC_KEY=pk_test_your_stripe_public_key
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Razorpay (Alternative)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# PayPal (Alternative)
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret
PAYPAL_MODE=sandbox

# =============================================================================
# REDIS CONFIGURATION (Optional - for caching)
# =============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# =============================================================================
# RATE LIMITING
# =============================================================================
# Requests per window
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# =============================================================================
# LOGGING
# =============================================================================
# Log Level (error, warn, info, debug)
LOG_LEVEL=info

# Log File Path
LOG_FILE_PATH=./logs/app.log

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================
# Default Admin Credentials (for initial setup)
DEFAULT_ADMIN_EMAIL=admin@collegeerp.com
DEFAULT_ADMIN_PASSWORD=Admin@123

# Institution Name
INSTITUTION_NAME=College ERP System

# Academic Year
CURRENT_ACADEMIC_YEAR=2024-2025

# Attendance Threshold (percentage)
ATTENDANCE_THRESHOLD=75

# =============================================================================
# NOTIFICATION SETTINGS
# =============================================================================
# Enable/Disable Notifications
ENABLE_EMAIL_NOTIFICATIONS=true
ENABLE_SMS_NOTIFICATIONS=false

# =============================================================================
# EXTERNAL API INTEGRATIONS
# =============================================================================
# Google OAuth (Optional)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# Zoom API (Optional)
ZOOM_API_KEY=your_zoom_api_key
ZOOM_API_SECRET=your_zoom_api_secret

# =============================================================================
# DEVELOPMENT SETTINGS
# =============================================================================
# Enable/Disable Features
ENABLE_SWAGGER=true
ENABLE_CORS=true
ENABLE_RATE_LIMIT=false

# Debug Mode
DEBUG=false
